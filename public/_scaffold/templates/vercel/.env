# Generated by Canopy Studio for local Vercel/Node development.
# The owner username/email and password hash come from your builder inputs.
# Never commit this file. ADMIN_PASSWORD_HASH is a salted PBKDF2 hash; the
# raw administrator password is not included here. CRON_SECRET protects the
# scheduled background payment-reminder endpoint.
#
# DATABASE_URL is the pooled Neon connection string you entered in the
# builder (sslmode/channel_binding are removed because the Neon HTTP driver
# does not use them). Replace the placeholder if you left it blank.
DATABASE_URL=__DATABASE_URL__
ADMIN_USERNAME=__ADMIN_USERNAME__
ADMIN_EMAIL=__ADMIN_EMAIL__
ADMIN_PASSWORD_HASH=__ADMIN_PASSWORD_HASH__
CSRF_SECRET=__CSRF_SECRET__
CRON_SECRET=__CRON_SECRET__
NODE_ENV=production

# For a deployed Vercel project, set these same values as Vercel project
# Environment Variables (Project Settings -> Environment Variables, or
# `vercel env add`). Do not rely on this local .env file in production.
