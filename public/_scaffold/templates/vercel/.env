# Generated by Canopy Studio. This file is ready to use as-is for local
# development with `npm run dev` / `vercel dev` — no copying or renaming
# needed. It is loaded automatically by dotenv.
#
# ADMIN_API_KEY and CSRF_SECRET below were randomly generated for this
# download; they are not shared with any other site. Keep this file secret
# and never commit it. Rotate these values any time with `openssl rand -hex 32`.
#
# DATABASE_URL is the pooled Neon connection string you entered in the
# builder (sslmode/channel_binding are removed automatically because the
# Neon serverless HTTP driver does not use them). If you did not enter one,
# replace the placeholder below with your own before running the app.
DATABASE_URL=__DATABASE_URL__
ADMIN_API_KEY=__ADMIN_API_KEY__
CSRF_SECRET=__CSRF_SECRET__
NODE_ENV=production

# For a deployed Vercel project, set the same values as Vercel project
# environment variables instead of relying on this file (Project Settings ->
# Environment Variables, or `vercel env add`).
