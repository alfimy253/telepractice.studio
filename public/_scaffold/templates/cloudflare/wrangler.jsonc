{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "__SITE_ID__-cloudflare",
  "main": "src/index.js",
  "compatibility_date": "2025-10-08",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "triggers": { "crons": ["* * * * *"] },
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true
  },
  // The production copy of .dev.vars. Wrangler never uploads .dev.vars during
  // deploy, so the same values are baked in here instead: `npm run deploy` is
  // a fully configured Worker and the owner dashboard's CSRF protection works
  // immediately after deploy.
  "vars": __WRANGLER_VARS__,
  "observability": {
    "enabled": true
  }
}
