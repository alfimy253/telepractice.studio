{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "canopy-studio-admin",
  "main": "src/index.js",
  "compatibility_date": "2025-10-08",
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  // Required by `npx wrangler preview` (Worker Previews). An empty block means
  // previews reuse these top-level settings (assets, compatibility, observability).
  "previews": {}
}
